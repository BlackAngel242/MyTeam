#!/bin/sh
# Vérifie exactement ce qui va être commité (l'index), dans un dossier temporaire :
# les fichiers que d'autres agents écrivent en parallèle ne sont ni touchés ni pris en compte.
# Motifs de secrets étendus, alignés sur src/masque.mjs : préfixes haute spécificité uniquement.
# Les formes génériques token=/password= sont volontairement absentes : elles bloqueraient le code
# légitime (const token=randomBytes…). Un faux positif ici coûte moins cher qu'un secret publié.
PATTERN='sk-[A-Za-z0-9]{20}|pk-[A-Za-z0-9_-]{20}|eyJ[A-Za-z0-9_-]{20}|gh[pousr]_[A-Za-z0-9]{20}|github_pat_[A-Za-z0-9_]{20}|xox[abprs]-[A-Za-z0-9-]{10}|AIza[0-9A-Za-z_-]{30}|Bearer[[:space:]]+[A-Za-z0-9._~+/-]{16}|creator_(account|user)_id"?[[:space:]]*:[[:space:]]*"?[a-z0-9-]{10}'
if git diff --cached -U0 | grep -E '^\+' | grep -qE "$PATTERN"; then
  echo "Commit refusé : un secret ou un identifiant de compte semble présent."; exit 1
fi
tmp=$(mktemp -d) || exit 1
trap 'rm -rf "$tmp"' EXIT
git checkout-index -a --prefix="$tmp/"
cd "$tmp" || exit 1
npm run --silent check || { echo "Commit refusé : npm run check échoue sur le contenu commité."; exit 1; }
npm test --silent >/dev/null 2>&1 || { echo "Commit refusé : npm test échoue sur le contenu commité."; exit 1; }
